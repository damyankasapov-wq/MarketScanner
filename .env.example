# Copy this file to .env and fill in your values.
# .env is excluded from git — never commit real credentials.

FINNHUB_API_KEY=

# Optional: free Alpaca account keys (https://alpaca.markets). The backtester
# uses them to backfill 1-minute bars older than yfinance's 30-day window
# (history since 2016). Leave empty to skip.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=sip   # only sip (all US exchanges) is supported; anything else stops the backfill

# Feed source: "auto" (Finnhub WS, yfinance fallback) or "yfinance" (poll only).
# docker-compose sets this to yfinance because the Finnhub free tier does not
# stream US ETFs.
FEED_MODE=auto

# Opening Range Breakout trigger: a completed candle of this many minutes must
# sit fully outside the 09:30-10:30 ET box and close in the breakout direction.
# Must divide 60. Optional; docker-compose pins it to 5.
CONFIRM_CANDLE_MINUTES=5

# Take profit in box widths; the stop always stays one box width. Unset = 1 (1:1,
# today's behaviour). Check a value with the backtester first:
#   python -m marketscanner.backtest ... --sweep --reward 1,1.5,2
# REWARD_RATIO=1

# Latest ET time (HH:MM, after 10:30, up to 16:00) a confirmation candle may close
# and still give an alert. A later first confirmation means no trade that day (the
# dashboard says so, no email). Unset = no cut-off (today's behaviour).
# CONFIRM_CUTOFF_ET=14:00

EMAIL_SENDER=
EMAIL_PASSWORD=        # Gmail app password
EMAIL_RECIPIENT=        # one or more addresses, comma-separated (e.g. you@gmail.com,andrej.bele@gmail.com)

# Deployment target (used by scripts/deploy.sh)
OVM_HOST=openmediavault.local
OVM_USER=root

# PostgreSQL (defaults match docker-compose.yml)
DB_HOST=openmediavault.local
DB_PORT=5432
DB_NAME=marketscanner
DB_USER=ms
DB_PASSWORD=ms
