# Copy this file to .env and fill in your values.
# .env is excluded from git — never commit real credentials.

FINNHUB_API_KEY=

# Feed source: "auto" (Finnhub WS, yfinance fallback) or "yfinance" (poll only).
# docker-compose sets this to yfinance because the Finnhub free tier does not
# stream US ETFs.
FEED_MODE=auto

# Opening Range Breakout trigger: a completed candle of this many minutes must
# sit fully outside the 09:30-10:30 ET box and close in the breakout direction.
# Must divide 60. Optional; docker-compose pins it to 5.
CONFIRM_CANDLE_MINUTES=5

EMAIL_SENDER=
EMAIL_PASSWORD=        # Gmail app password
EMAIL_RECIPIENT=        # one or more addresses, comma-separated (e.g. you@gmail.com,andrej.bele@gmail.com)

# Deployment target (used by scripts/deploy.sh)
OVM_HOST=openmediavault.local
OVM_USER=root

# PostgreSQL (defaults match docker-compose.yml)
DB_HOST=openmediavault.local
DB_PORT=5432
DB_NAME=marketscanner
DB_USER=ms
DB_PASSWORD=ms
